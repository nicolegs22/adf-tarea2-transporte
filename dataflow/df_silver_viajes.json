{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as integer,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(ViajeId = trim(toString(ViajeId)),",
				"          RutaHistoricaId = upper(trim(RutaHistoricaId)),",
				"          VehiculoId = upper(trim(VehiculoId)),",
				"          EstadoViaje = trim(EstadoViaje),",
				"          KmRecorridos = toDecimal(replace(toString(KmRecorridos), ',', '.'), 10, 2)) ~> derivedColumn1",
				"derivedColumn1 derive(FechaServicio = iif(instr(toString(FechaServicio), '/') > 0, toDate(toString(FechaServicio), 'dd/MM/yyyy'), toDate(toString(FechaServicio), 'yyyy-MM-dd')),",
				"          HoraProgramada = left(trim(toString(HoraProgramada)), 5),",
				"          HoraSalida = left(trim(toString(HoraSalida)), 5),",
				"          HoraLlegada = left(trim(toString(HoraLlegada)), 5)) ~> derivedColumn2",
				"derivedColumn2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> sink1"
			]
		}
	}
}